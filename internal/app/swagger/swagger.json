{
    "swagger": "2.0",
    "info": {
        "description": "tf-api 服务端接口",
        "title": "tf-api",
        "contact": {},
        "version": "1.0.0"
    },
    "paths": {
        "/api/ping": {
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "Ping",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/tf-api_internal_app_ginx.Resp"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "string"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/api/system/info": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "运行时信息",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/tf-api_internal_app_ginx.Resp"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "健康检查",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/tf-api_internal_app_service.HealthStatus"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "tf-api_internal_app_ginx.Resp": {
            "type": "object",
            "properties": {
                "code": {
                    "description": "业务错误码，200 = 成功",
                    "type": "integer"
                },
                "data": {},
                "error": {
                    "description": "为空时该字段不出现",
                    "type": "string"
                }
            }
        },
        "tf-api_internal_app_service.HealthStatus": {
            "type": "object",
            "properties": {
                "checks": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "database": {
                    "type": "object",
                    "additionalProperties": true
                },
                "env": {
                    "type": "string"
                },
                "status": {
                    "description": "ok | degraded",
                    "type": "string"
                },
                "uptime": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}